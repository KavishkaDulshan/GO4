# =============================================================
# Go4 Server – Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.
# =============================================================

# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas
# ⚠️  Special chars in password MUST be URL-encoded:  > → %3E  @ → %40  # → %23
ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>

# Google Gemini 2.5 Flash – Vision & text understanding (1.5/2.0 deprecated)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Whisper – Voice-to-text transcription
OPENAI_API_KEY=your_openai_api_key_here

# Serper.dev – Real-time Google Shopping data
SERPER_API_KEY=your_serper_api_key_here

# Google Maps Platform – Flutter SDK key (Android app restriction, used in flutter app)
GOOGLE_MAPS_API_KEY=your_google_maps_android_key_here

# Google Maps Server key – for backend Geocoding/Places/Directions calls
# Create at: GCP Console → Credentials → + CREATE CREDENTIALS → API key
# Set restriction: "IP addresses" (or None for dev), enable: Geocoding, Places, Directions APIs
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Google OAuth – verify Google Sign-In ID tokens from the Flutter app
GOOGLE_CLIENT_ID=your_google_client_id_here
